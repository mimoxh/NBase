# Generate local files with: node -- scripts/setup-docker.mjs
# Keep the project name stable: it determines persistent volume names.
NBASE_COMPOSE_PROJECT=nbase
NBASE_IMAGE_TAG=local
NBASE_PORT=3000
NBASE_PUBLIC_ORIGIN=http://127.0.0.1:3000
NBASE_DB_PASSWORD_SOURCE=./.secrets/nbase/db-password
NBASE_OWNER_PASSWORD_SOURCE=./.secrets/nbase/owner-password
NBASE_OWNER_LOGIN=owner
